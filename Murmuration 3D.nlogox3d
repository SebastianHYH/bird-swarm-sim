<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 3D 7.0.4" snapToGrid="false">
  <code><![CDATA[;; =====================================================================
;; Murmuration 3D
;; ---------------------------------------------------------------------
;; A NetLogo 3D model of a starling murmuration, extended from the
;; NetLogo Models Library "Flocking 3D" model (Wilensky, 1998).
;;
;; Main changes compared to Flocking 3D:
;;   1. Steering uses 3D VECTORS. Every rule (separation, alignment,
;;      cohesion, roost pull, noise) produces a vector; the vectors are
;;      added with weights and the bird turns toward the result, limited
;;      by a maximum turn angle per tick.
;;   2. Neighbours can be TOPOLOGICAL (the k nearest birds, as measured
;;      in real starlings by Ballerini et al. 2008) or METRIC (every bird
;;      inside the vision radius, as in the original model).
;;   3. Birds have VARIABLE SPEED: birds behind their neighbours speed up,
;;      birds in front slow down.
;;   4. No world wrapping. A soft ROOST PULL keeps the flock over one spot.
;;   5. Small random NOISE keeps the shape from freezing.
;;   6. Birds can be coloured by how CROWDED they are, and there are
;;      plots for polarisation and spread, a flock-following camera and
;;      two presets.
;; =====================================================================

turtles-own [
  flockmates     ;; agentset of the neighbours this bird reacts to
  crowding       ;; number of birds inside my vision radius (for colouring)
  speed          ;; my current speed, in patches per tick
]

globals [
  flock-x flock-y flock-z   ;; centre of mass of the whole flock (updated every tick)
  follow-flock?             ;; is the camera following the flock?
]

;; ---------------------------------------------------------------------
;; SETUP
;; ---------------------------------------------------------------------

to setup
  clear-all
  set-default-shape turtles "default"
  set follow-flock? false
  create-turtles population [
    ;; start in a loose ball around the roost, pointing in random directions
    setxyz (random-float 16 - 8) (random-float 16 - 8) (random-float 10 - 5)
    set heading random-float 360
    set pitch asin (1 - random-float 2)   ;; uniform random direction on a sphere
    set roll 0
    set size 0.7
    set speed (min-speed + max-speed) / 2
    set flockmates no-turtles
    set crowding 0
  ]
  ask turtles [ find-flockmates ]   ;; so crowding colours are right from tick 0
  update-flock-centre
  recolor-birds
  default-camera
  reset-ticks
end

;; ---------------------------------------------------------------------
;; GO
;; ---------------------------------------------------------------------

to go
  ;; 1. every bird looks around and decides where to turn and how fast to fly.
  ;;    Finding neighbours is the slowest step, so each bird refreshes its
  ;;    neighbour list every OTHER tick (half the flock per tick). Neighbours
  ;;    change slowly, so this barely affects behaviour but is much faster.
  ask turtles [ if ticks = 0 or (who + ticks) mod 2 = 0 [ find-flockmates ] ]
  ask turtles [ steer ]
  ;; 2. every bird moves
  ask turtles [ move ]
  ;; 3. bookkeeping: flock centre, colours, camera
  update-flock-centre
  recolor-birds
  if follow-flock? [ update-camera ]
  tick
end

;; ---------------------------------------------------------------------
;; NEIGHBOURS
;; ---------------------------------------------------------------------

to find-flockmates  ;; turtle procedure
  ;; every bird I can see (within the vision radius)
  let visible other turtles in-radius vision
  set crowding count visible
  ifelse topological?
    ;; topological: only my k nearest visible birds
    [ set flockmates min-n-of (min (list k-neighbours crowding)) visible [ distance myself ] ]
    ;; metric: every bird I can see
    [ set flockmates visible ]
end

;; ---------------------------------------------------------------------
;; STEERING
;; Each rule reports a 3D vector [x y z]. Their weighted sum is added to
;; my current direction, and I turn toward that, at most max-turn degrees.
;; ---------------------------------------------------------------------

to steer  ;; turtle procedure
  let my-dir (list dx dy dz)          ;; my current direction (unit vector)
  let total my-dir                    ;; start from "keep going straight"
  if any? flockmates [
    set total vadd total vscale separation-weight separation-vector
    set total vadd total vscale alignment-weight alignment-vector
    set total vadd total vscale cohesion-weight cohesion-vector
  ]
  set total vadd total vscale roost-weight roost-vector
  set total vadd total vscale noise random-unit-vector
  turn-toward total max-turn
  adjust-speed
end

;; SEPARATION: push away from neighbours that are closer than
;; separation-distance. Closer neighbours push harder (0 at the edge,
;; 1 when touching).
to-report separation-vector  ;; turtle procedure
  let result [0 0 0]
  ask flockmates with [ distance myself < separation-distance ] [
    let away vsub (list [xcor] of myself [ycor] of myself [zcor] of myself) (list xcor ycor zcor)
    let d vlength away
    if d > 0 [
      set result vadd result vscale ((1 - d / separation-distance) / d) away
    ]
  ]
  report result
end

;; ALIGNMENT: the average flying direction of my neighbours.
;; This averages true 3D direction vectors, which fixes the original
;; model's separate averaging of heading and pitch.
to-report alignment-vector  ;; turtle procedure
  report vnormalize (list (mean [dx] of flockmates)
                          (mean [dy] of flockmates)
                          (mean [dz] of flockmates))
end

;; COHESION: toward the centre of my neighbours. Scaled by the vision
;; radius, so it is weak when they are close and strong when far.
to-report cohesion-vector  ;; turtle procedure
  let to-centre (list (mean [xcor] of flockmates - xcor)
                      (mean [ycor] of flockmates - ycor)
                      (mean [zcor] of flockmates - zcor))
  report vscale (1 / vision) to-centre
end

;; ROOST PULL: toward the roost point (centre of the world). Zero inside
;; roost-radius, then grows linearly the further outside I am.
to-report roost-vector  ;; turtle procedure
  let to-roost (list (0 - xcor) (0 - ycor) (0 - zcor))
  let d vlength to-roost
  if d <= roost-radius [ report [0 0 0] ]
  report vscale ((d - roost-radius) / roost-radius / d) to-roost
end

;; NOISE: a random direction, uniformly distributed on a sphere.
to-report random-unit-vector
  let z 1 - random-float 2
  let angle random-float 360
  let r sqrt (1 - z * z)
  report (list (r * cos angle) (r * sin angle) z)
end

;; Turn toward direction `target`, rotating by at most `max-angle` degrees.
;; Uses spherical interpolation between my current direction and the target.
to turn-toward [ target max-angle ]  ;; turtle procedure
  let goal vnormalize target
  if vlength goal = 0 [ stop ]
  let current (list dx dy dz)
  let cos-angle max (list -1 (min (list 1 vdot current goal)))
  let angle acos cos-angle
  if angle < 0.001 [ stop ]
  let new-dir goal
  if angle > max-angle [
    if angle > 179.9 [
      ;; the target is directly behind me; slerp is undefined, so turn sideways
      rt max-angle
      stop
    ]
    ;; slerp: rotate `current` toward `goal` by exactly max-angle degrees
    let t max-angle / angle
    let s sin angle
    set new-dir vadd (vscale (sin ((1 - t) * angle) / s) current)
                     (vscale (sin (t * angle) / s) goal)
  ]
  facexyz (xcor + item 0 new-dir) (ycor + item 1 new-dir) (zcor + item 2 new-dir)
  set roll 0
end

;; VARIABLE SPEED: if my neighbours are ahead of me, speed up; if they are
;; behind me, slow down. Without neighbours, drift back to cruising speed.
to adjust-speed  ;; turtle procedure
  let cruise (min-speed + max-speed) / 2
  let target cruise
  if any? flockmates [
    let to-centre (list (mean [xcor] of flockmates - xcor)
                        (mean [ycor] of flockmates - ycor)
                        (mean [zcor] of flockmates - zcor))
    ;; how far ahead (+) or behind (-) of me my neighbours are
    let ahead vdot to-centre (list dx dy dz)
    set target cruise + speed-response * ahead
  ]
  ;; change speed gradually (10% of the gap each tick), then clamp
  set speed speed + 0.1 * (target - speed)
  set speed max (list min-speed (min (list max-speed speed)))
end

;; ---------------------------------------------------------------------
;; MOVEMENT
;; ---------------------------------------------------------------------

to move  ;; turtle procedure
  ifelse can-move? speed
    [ fd speed ]
    ;; the world does not wrap: at the very edge, face the roost instead.
    ;; (the roost pull normally keeps birds far from the edge)
    [ facexyz 0 0 0
      set roll 0 ]
end

;; ---------------------------------------------------------------------
;; FLOCK MEASUREMENTS (used by plots, colours and the camera)
;; ---------------------------------------------------------------------

to update-flock-centre
  ifelse any? turtles [
    set flock-x mean [xcor] of turtles
    set flock-y mean [ycor] of turtles
    set flock-z mean [zcor] of turtles
  ] [
    set flock-x 0 set flock-y 0 set flock-z 0
  ]
end

;; POLARISATION: 1 = every bird flies the same direction, 0 = random directions.
;; The length of the average direction vector.
to-report polarisation
  if not any? turtles [ report 0 ]
  report vlength (list (mean [dx] of turtles) (mean [dy] of turtles) (mean [dz] of turtles))
end

;; SPREAD: average distance of the birds from the flock's centre.
to-report spread
  if not any? turtles [ report 0 ]
  report mean [ distancexyz flock-x flock-y flock-z ] of turtles
end

;; ---------------------------------------------------------------------
;; COLOURS
;; ---------------------------------------------------------------------

to recolor-birds
  ifelse colour-mode = "crowding" [
    ;; dim orange at the thin edges -> near white in the dense core
    let most max (list 1 (max [crowding] of turtles))
    ask turtles [ set color 22 + 7.8 * (crowding / most) ]
  ] [
    ask turtles [ set color white ]
  ]
end

;; ---------------------------------------------------------------------
;; CAMERA
;; ---------------------------------------------------------------------

to toggle-follow-flock
  set follow-flock? not follow-flock?
  ifelse follow-flock? [ update-camera ] [ default-camera ]
end

;; a side view from near the ground, looking at the roost (like the video)
to default-camera
  reset-perspective
  setxyz 0 (0 - camera-distance) 5
  facexyz 0 0 0
end

to update-camera
  ;; stand back from the flock's centre and look at it
  setxyz flock-x (flock-y - camera-distance) (flock-z + camera-distance / 3)
  facexyz flock-x flock-y flock-z
end

;; ---------------------------------------------------------------------
;; PRESETS (known-good slider settings for the demo)
;; ---------------------------------------------------------------------

to preset-calm
  set topological? true
  set k-neighbours 12
  set vision 6
  set separation-distance 2
  set separation-weight 1.5
  set alignment-weight 1.5
  set cohesion-weight 1
  set roost-radius 8
  set roost-weight 0.5
  set min-speed 0.2
  set max-speed 0.4
  set speed-response 0.05
  set max-turn 6
  set noise 0.1
end

to preset-turbulent
  set topological? true
  set k-neighbours 7
  set vision 6
  set separation-distance 2
  set separation-weight 1.5
  set alignment-weight 1
  set cohesion-weight 1
  set roost-radius 12
  set roost-weight 3
  set min-speed 0.1
  set max-speed 0.8
  set speed-response 0.3
  set max-turn 20
  set noise 0.15
end

;; ---------------------------------------------------------------------
;; 3D VECTOR HELPERS (vectors are lists [x y z])
;; ---------------------------------------------------------------------

to-report vadd [ a b ]
  report (map + a b)
end

to-report vsub [ a b ]
  report (map - a b)
end

to-report vscale [ k v ]
  report map [ c -> k * c ] v
end

to-report vdot [ a b ]
  report sum (map * a b)
end

to-report vlength [ v ]
  report sqrt vdot v v
end

to-report vnormalize [ v ]
  let len vlength v
  if len = 0 [ report v ]
  report vscale (1 / len) v
end

; Based on: Wilensky, U. (1998). NetLogo Flocking 3D model.
; Copyright 1998 Uri Wilensky. CC BY-NC-SA 3.0.
]]></code>
